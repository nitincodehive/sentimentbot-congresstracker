# Copy to .env for LOCAL runs only. .env is gitignored — never commit real values.
# In CI these are supplied as GitHub Actions repository secrets.

# Telegram bot dedicated to this project (NOT the swingscanner bot)
TELEGRAM_BOT_TOKEN=123456789:AA-replace-me
# Same chat used by the sentiment-bot-xsearch project
TELEGRAM_CHAT_ID=-1001234567890

# Google service account JSON, pasted as a single-line JSON string
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# The spreadsheet key from its URL: docs.google.com/spreadsheets/d/<THIS>/edit
SPREADSHEET_ID=replace-with-spreadsheet-key
